<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>SignInPage.AspNetCore</RootNamespace>
    <PackageId>Dloizides.SignInPage.AspNetCore</PackageId>
    <StaticWebAssetBasePath>_content/Dloizides.SignInPage.AspNetCore</StaticWebAssetBasePath>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="schema/sign-in-config.schema.json" LogicalName="SignInPage.AspNetCore.sign-in-config.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SignInPage.AspNetCore.Tests" />
  </ItemGroup>

</Project>
