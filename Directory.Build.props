<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <HouseArchitectureStyle>Clean</HouseArchitectureStyle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <Authors>DLoizides</Authors>
    <Company>DLoizides</Company>
    <PackageProjectUrl>https://github.com/openmindednewby/Dloizides.SignInPage.AspNetCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/openmindednewby/Dloizides.SignInPage.AspNetCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>sign-in;login;page;openiddict;aspnetcore;server-rendered;theme</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Brand-neutral server-rendered sign-in page for ASP.NET Core: email + password form, optional demo-account list, logo slot with logo-kit motion, every colour from theme tokens passed in as data.</Description>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dloizides.Analyzers" Version="0.6.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
